// lean-lab note template: mousse-notes plus helpers that link prose to Lean.
//
// Import from any note with an absolute (project-root) path:
//
//   #import "/notes/template/lab.typ": *
//
// and compile with the repository root as the Typst root:
//
//   typst compile --root . directions/<Name>/notes/main.typ
//
// Conventions (see AGENTS.md §9):
//   - idea.typ   is written by humans; agents do not edit it.
//   - formal.typ is written by agents.
//   - main.typ   sets up the document and includes both.

#import "@preview/mousse-notes:2.0.1": *

// Lean status database, generated by `scripts/notes.py`. Do not edit by hand.
#let _status-db = json("/notes/status.json")

/// Document setup for a direction's notes. Use as `#show: lab.with(...)`.
///
/// - title (str): Document title (shown on the title page).
/// - subtitle (content): Short description beside the title.
/// - primary (content): Text below the title.
/// - secondary (content): Text below `primary`.
/// - author (str, array): Author(s) for the PDF metadata.
#let lab(
  title: "Untitled",
  subtitle: none,
  primary: none,
  secondary: none,
  author: (),
  body,
) = {
  set document(title: title, author: author)
  set page(paper: "us-letter")
  // mousse requires `style` to be the last show rule.
  show: style
  title-page(subtitle: subtitle, primary: primary, secondary: secondary)
  body
}

/// Link the enclosing claim to the Lean declaration that formalises it.
///
/// Renders a small status tag and records machine-readable metadata, so
/// `typst eval 'query(<lean>).map(it => it.value)'` lists every link.
///
/// - decl (str): Fully qualified Lean name, e.g. "LeanLab.Foo.bar".
/// - claim (label): Label of the informal claim (usually in idea.typ) that
///   `decl` formalises, e.g. `<thm_foo>`.
/// - refutes (bool): The Lean declaration proves the *negation* of the claim.
///   When that declaration is proved, the claim is shown as "refuted".
#let lean(decl, claim: none, refutes: false) = {
  let entry = _status-db.at(decl, default: none)
  let status = if entry == none { "unchecked" } else { entry.status }
  if refutes and status == "proved" { status = "refuted" }
  let claim-str = if claim == none { none } else { str(claim) }
  [#metadata((decl: decl, claim: claim-str, refutes: refutes))<lean>]
  if claim != none [#ref(claim): ]
  box(text(size: 0.8em, style: "normal")[
    \[Lean: #raw(decl) · #strong(status)\]
  ])
}

/// The reading an agent chose for an ambiguous informal claim.
#let reading(body, name: none) = thm-env(
  "Reading",
  fmt: emph,
  body-fmt: it => it,
  numbered: false,
  counter-type: "reading",
)(body, name: name)

/// A question for the human. Leave `answer` empty until it is answered; the
/// answer is written by the human (in the question call or in idea.typ).
///
/// Open questions are listed by `typst eval 'query(<question>)...'`.
#let question(body, name: none, answer: none) = {
  [#metadata((answered: answer != none))<question>]
  thm-env(
    if answer == none { "Open question" } else { "Question" },
    fmt: emph,
    body-fmt: it => it,
    numbered: false,
    counter-type: "question",
  )(body, name: name)
  if answer != none {
    thm-env(
      "Answer",
      fmt: emph,
      body-fmt: it => it,
      numbered: false,
      counter-type: "answer",
    )(answer)
  }
}
